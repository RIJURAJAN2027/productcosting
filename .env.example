# Copy to .env and change every value marked CHANGE ME. Never commit .env.

# PostgreSQL password (letters and digits only, it is used inside a URL)                    CHANGE ME
POSTGRES_PASSWORD=change-me-db-password

# Signs login tokens: a random string of at least 32 characters                             CHANGE ME
# e.g.  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PC_SECRET_KEY=

# First administrator, created when the database is empty. Change the password after login.  CHANGE ME
PC_BOOTSTRAP_TENANT=My Organisation
PC_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PC_BOOTSTRAP_ADMIN_PASSWORD=

# Create the fictional demo company on first start (useful for training; can be deleted later)
PC_LOAD_DEMO_COMPANY=true

# Web port on the host, number of server processes, login lifetime (minutes), upload limit
APP_PORT=8080
WEB_CONCURRENCY=2
PC_ACCESS_TOKEN_MINUTES=720
PC_MAX_UPLOAD_MB=50

# Only needed when the UI is served from another origin (development)
PC_CORS_ORIGINS=

# Single sign-on with OpenID Connect (Microsoft Entra ID, Okta, Google, Keycloak …) – optional
# Redirect URI to register with the identity provider: https://<your-host>/api/auth/sso/callback
PC_OIDC_ISSUER=
PC_OIDC_CLIENT_ID=
PC_OIDC_CLIENT_SECRET=
PC_OIDC_REDIRECT_URI=
